{
  "default_format": "table",
  "table_style": "github",
  "max_rows": 100,
  "show_timestamps": true,
  "date_format": "%Y-%m-%d %H:%M:%S",
  "auto_refresh": false,
  "refresh_interval": 30,
  "color_output": true,
  "compact_mode": false,
  "show_headers": true,
  "export_path": "exports/",
  "filters": {
    "default_timeframe": 24,
    "default_levels": [
      "success",
      "error",
      "warning"
    ],
    "default_categories": [
      "telescope",
      "system",
      "logs"
    ]
  }
}